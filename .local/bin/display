#!/usr/bin/env bash

INTERNAL_OUTPUT="eDP-1"
INTERNAL_AUDIO=$(pactl list sinks | grep Name | awk -F: '{print $2}' | grep analog)

EXTERNAL_OUTPUT="HDMI-1"
EXTERNAL_AUDIO=$(pactl list sinks | grep Name | awk -F: '{print $2}' | grep hdmi)

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected="pc"
fi

case "$selected" in
    "--duplicate")
        echo "Duplicate display"
        xrandr --output $EXTERNAL_OUTPUT --auto --same-as $INTERNAL_OUTPUT
        ;;
    "--extend")
        echo "Extend display"
        ;;
    "--second")
        echo "Second Monitor only"
        xrandr --output $INTERNAL_OUTPUT --off
        xrandr --output $EXTERNAL_OUTPUT --auto --primary
        ;;
    *)
        echo "PC screen only"
        xrandr --output $EXTERNAL_OUTPUT --off
        xrandr --output $INTERNAL_OUTPUT --primary --auto
        xrandr --output $INTERNAL_OUTPUT --brightness 1
        pactl set-default-sink $INTERNAL_AUDIO
        ;;
esac
